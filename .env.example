# ==========================================
# 1. WhatsApp Document API (UltraMsg / Green-API)
# Delivers actual native PDF document attachments into WhatsApp chat!
# ==========================================
# Get your free Instance ID & Token from https://ultramsg.com or https://green-api.com
VITE_WHATSAPP_API_PROVIDER=ultramsg
VITE_WHATSAPP_INSTANCE_ID=instance12345
VITE_WHATSAPP_TOKEN=your_ultramsg_token_here

# ==========================================
# 2. Cloud Storage Configuration (Optional Link Fallback)
# ==========================================
# Option A: Supabase Storage
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
# VITE_SUPABASE_BUCKET=invoices

# Option B: Cloudinary
# VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
